# Copy to .env and fill in. .env is git-ignored.
# On the server it lives in the deploy folder, next to compose.yaml. The deploy
# tool never sends or overwrites it.

# Anthropic API key for the AI fallback. Leave empty to turn the fallback off.
ANTHROPIC_API_KEY=

# Tokens of the two Cloudflare Tunnels (Zero Trust dashboard > Networks > Tunnels).
# App tunnel: public hostname -> http://frontend:80, with an Access policy.
APP_TUNNEL_TOKEN=
# Calendar tunnel: mucalendar.michaelbielen.be -> http://frontend:8081, no Access policy.
CALENDAR_TUNNEL_TOKEN=

# The public address of the calendar feed, shown at the top of the page.
CALENDAR_URL=https://mucalendar.michaelbielen.be/calendar.ics

# Loopback ports for checking the deployment from the server itself.
MUC_PORT=8642
MUC_CALENDAR_PORT=8643
