# Optional. Copy to .env to change a default; .env is git-ignored.
# On the server it lives in the deploy folder, next to compose.yaml. The deploy
# tool never sends or overwrites it.

# Anthropic API key for the AI fallback. Leave empty to turn the fallback off.
ANTHROPIC_API_KEY=

# The public address of the calendar feed, shown at the top of the page.
CALENDAR_URL=https://mucalendar.michaelbielen.be/calendar.ics

# Where the two ports are published. 0.0.0.0 = reachable on the local network,
# which the Cloudflare Tunnels on another machine need. 127.0.0.1 = this host only.
MUC_BIND=0.0.0.0
# The app (point the Access-protected tunnel here).
MUC_PORT=8642
# The calendar feed only (point mucalendar.michaelbielen.be here).
MUC_CALENDAR_PORT=8643
